% The pilot intentionally reuses Stock signs. A later authored AMS overlay is
% explicit: select its exact scalar when present, otherwise preserve stock use.
\newcommand\BCAMS@choose[1]{%
  \edef\BCAMS@family{\number\symbcmup}%
  \ifBCAMS@authoredoverlay
    \iffontchar\textfont\symoperators "#1\relax
      \edef\BCAMS@family{\number\symoperators}%
    \fi
  \fi}
\newcommand\BCAMS@declare[3]{%
  \BCAMS@choose{#3}%
  \protected\edef#1{\noexpand\Umathchar #2 \BCAMS@family "#3\relax}%
}
\newcommand\BCAMS@literal[2]{%
  \BCAMS@choose{#2}\Umathcode "#2 = #1 \BCAMS@family "#2\relax}
\newcommand\BCAMS@delimiter[3]{%
  \BCAMS@choose{#3}%
  \protected\edef#1{\noexpand\Udelimiter #2 \BCAMS@family "#3\relax}%
  \Udelcode "#3 = \BCAMS@family "#3\relax}
\newcommand\BCAMS@arrow[3]{%
  \BCAMS@choose{#3}%
  % An unavailable authored variant must be a missing glyph, never a legacy
  % construction or another arrow whose head/bar semantics merely resemble it.
  \iffontchar\textfont\BCAMS@family "#3\relax\else
    \edef\BCAMS@family{\number\symoperators}%
  \fi
  \BCAMS@verticalarrowfalse
  \ifnum"#3="2191\relax\BCAMS@verticalarrowtrue\fi
  \ifnum"#3="2193\relax\BCAMS@verticalarrowtrue\fi
  \ifnum"#3="2195\relax\BCAMS@verticalarrowtrue\fi
  \ifnum"#3="21D1\relax\BCAMS@verticalarrowtrue\fi
  \ifnum"#3="21D3\relax\BCAMS@verticalarrowtrue\fi
  \ifnum"#3="21D5\relax\BCAMS@verticalarrowtrue\fi
  \ifBCAMS@verticalarrow
    \protected\edef#1{\noexpand\Udelimiter #2 \BCAMS@family "#3\relax}%
    \Udelcode "#3 = \BCAMS@family "#3\relax
  \else
    \protected\edef#1{\noexpand\Umathchar #2 \BCAMS@family "#3\relax}%
  \fi
  \Umathcode "#3 = #2 \BCAMS@family "#3\relax}
