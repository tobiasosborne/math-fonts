% Explicit opt-in native Greek alternates. Every binding uses the exact Unicode
% character; epsilon/phi shape variants absent from Storm remain errors.
\newcommand\BCAMS@greek[2]{%
  \protected\def#1{\Umathchar 7 \BCAMS@greekfamily "#2\relax}%
  \Umathcode "#2 = 7 \BCAMS@greekfamily "#2\relax}
\newcommand\BCAMS@nogreek[1]{%
  \protected\def#1{\PackageError{baskervillecompanionams}%
    {Native Storm Greek variant unavailable}%
    {Use a supported exact native character, or leave this opt-in alternate.}}}
